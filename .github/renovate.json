{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openshift/boilerplate//.github/renovate.json"
  ],
  "enabledManagers": [
    "tekton",
    "gomod"
  ],
  "packageRules": [
    {
      "matchManagers": ["tekton"],
      "matchPackagePatterns": ["^quay.io/konflux-ci/tekton-catalog/"],
      "versioning": "loose"
    }
  ]
}
